{
  "name": "@ondewo/sip-client-nodejs",
  "version": "5.4.1",
  "description": "ONDEWO Session Initiation Protocol (SIP) Client library for Nodejs",
  "author": "ONDEWO GmbH <office@ondewo.com>",
  "homepage": "https://ondewo.com",
  "license": "Apache-2.0",
  "keywords": [
    "ondewo",
    "sip",
    "api",
    "client",
    "nodejs",
    "grpc"
  ],
  "main": "public-api.js",
  "typings": "public-api.d.ts",
  "scripts": {
    "start": "npm run build",
    "build": "docker run -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-nodejs-proto-compiler ondewo-sip-api ondewo",
    "predebug": "mv ondewo-sip-api/googleapis/google ondewo-sip-api/google",
    "debug": "docker run --entrypoint /bin/bash -v ${PWD}:/input-volume -v ${PWD}/..:/output-volume ondewo-nodejs-proto-compiler",
    "pretest": "tsc auth/offlineTokenProvider.ts auth/offlineTokenProvider.spec.ts --ignoreConfig --module commonjs --target es2020 --strict --lib es2020,dom --skipLibCheck --sourceMap --types node --typeRoots ./node_modules/@types --outDir .test-build",
    "test": "c8 --check-coverage --lines 100 --branches 100 --functions 100 --include '**/offlineTokenProvider.js' --exclude '**/*.spec.js' --reporter text node --test .test-build/offlineTokenProvider.spec.js"
  },
  "repository": {
    "type": "git",
    "directory": "https://github.com/ondewo/ondewo-sip-client-nodejs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@types/node": "^22.15.27",
    "dotenv": "^16.4.5",
    "google-protobuf": "3.21.4",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "c8": "^11.0.0",
    "eslint": "^9.39.5",
    "global": "^4.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3"
  }
}
